rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function ownPath(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId}/experiences/{experienceId}/wines/{wineId}/audio/{assetId} {
      allow read, delete: if ownPath(userId);
      allow write: if ownPath(userId)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    match /users/{userId}/experiences/{experienceId}/wines/{wineId}/photos/{assetId} {
      allow read, delete: if ownPath(userId);
      allow write: if ownPath(userId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/experiences/{experienceId}/photos/{assetId} {
      allow read, delete: if ownPath(userId);
      allow write: if ownPath(userId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
