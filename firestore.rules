rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.userId == request.auth.uid; }
    function validReaction(value) { return value == 'Loved it' || value == 'Liked it' || value == 'Not for me'; }
    function validRating(value) { return value is int && value >= 1 && value <= 5; }
    function validExperience(data) {
      return data.userId is string
        && data.farmId is string
        && data.farmName is string
        && data.wineCount is int
        && data.wineCount >= 0
        && data.wineCount <= 7
        && (data.status == 'active' || data.status == 'completed')
        && (!('overallRating' in data) || validRating(data.overallRating));
    }
    function validWine(data, experienceId) {
      return data.userId is string
        && data.experienceId == experienceId
        && data.name is string
        && data.name.size() <= 200
        && (!('confirmedName' in data) || (data.confirmedName is string && data.confirmedName.size() <= 200))
        && (!('note' in data) || (data.note is string && data.note.size() <= 2000))
        && validReaction(data.reaction)
        && (data.status == 'draft' || data.status == 'waiting_upload' || data.status == 'processing' || data.status == 'ready' || data.status == 'error');
    }

    match /users/{userId} {
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;

      match /experiences/{experienceId} {
        allow read, delete: if owns(resource.data);
        allow create: if owns(request.resource.data)
          && request.resource.data.userId == userId
          && validExperience(request.resource.data);
        allow update: if owns(resource.data) && owns(request.resource.data)
          && request.resource.data.userId == userId
          && validExperience(request.resource.data);

        match /wines/{wineId} {
          allow read, delete: if owns(resource.data);
          allow create: if owns(request.resource.data)
            && request.resource.data.userId == userId
            && validWine(request.resource.data, experienceId);
          allow update: if owns(resource.data) && owns(request.resource.data)
            && request.resource.data.userId == userId
            && validWine(request.resource.data, experienceId);

          match /reflections/{reflectionId} {
            allow read, delete: if owns(resource.data);
            allow create, update: if owns(request.resource.data)
              && request.resource.data.userId == userId
              && request.resource.data.experienceId == experienceId
              && request.resource.data.wineId == wineId
              && request.resource.data.note is string
              && request.resource.data.note.size() <= 4000
              && (request.resource.data.type == 'at_home' || request.resource.data.type == 'general')
              && (!('reaction' in request.resource.data) || validReaction(request.resource.data.reaction));
          }
        }
      }

      match /processingJobs/{jobId} {
        allow read: if owns(resource.data);
        allow create: if owns(request.resource.data)
          && request.resource.data.userId == userId
          && request.resource.data.status == 'queued';
        // Job state and extraction results are trusted-worker-only. The client
        // may create a queued job, read its status, or delete it, but cannot
        // mark work ready, alter retry counters, or inject provider output.
        allow update: if false;
        allow delete: if owns(resource.data);
      }
    }

    match /farms/{farmId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
